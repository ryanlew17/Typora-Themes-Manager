__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# ---- 工具 / 编辑器 ---------------------------------------------------------
.zcode/
.idea/
.vscode/
*.swp

# ---- 系统杂项 --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
